# ============================================================
# Utility: Handle → DID
# ============================================================
def did_from_handle(handle: str) -> str:
    """
    Resolve DID associated with handle.
    """
    return requests.get(
        "https://bsky.social/xrpc/com.atproto.identity.resolveHandle",
        params={"handle": handle},
        timeout=10,
    ).json()["did"]


# ============================================================
# Utility: Bluesky Post Fetcher
# ============================================================
def post_from_url(client: Client, url: str):
    """
    Extract the post given a public URL.
    """
    parts = url.split("/")
    rkey = parts[-1]
    handle = parts[-3]
    return client.get_post(rkey, handle)


def extract_did_from_uri(uri: str) -> str:
    """
    Given a Bluesky record URI, return the author DID.
    Example:
        at://did:plc:abcd12345/app.bsky.feed.post/xyz
        → did:plc:abcd12345
    """
    parts = uri.split("/")
    if len(parts) < 3:
        return ""
    return parts[2]  # the DID


def get_author_from_did(client, did: str) -> Optional[Dict[str, Any]]:
    """
    Resolve a DID → full actor profile.
    `client` is an atproto.Client instance.

    Returns:
        {
            "did": str,
            "handle": str,
            "display_name": str | None,
            "description": str | None,
            "avatar": str | None,
            ...
        }
        or None if lookup fails.
    """
    if not did:
        return None

    try:
        profile = client.app.bsky.actor.get_profile({"actor": did})
    except Exception:
        return None

    return {
        "did": profile.did,
        "handle": profile.handle,
        "display_name": getattr(profile, "displayName", None),
        "description": getattr(profile, "description", None),
        "avatar": getattr(profile, "avatar", None),
    }


# ============================================================
# MODULE 1 — Donation Intent Classifier
# ============================================================
class DonationIntentClassifier:
    """
    Donation intent detector.
    """

    # Simple keyword dictionary to approximate donation-related phrasing
    donation_keywords: List[str] = [
        "donate",
        "donation",
        "fundraiser",
        "fundraising",
        "gofundme",
        "gofund.me",
        "venmo",
        "paypal",
        "cashapp",
        "cashtag",
        "zelle",
        "help us raise",
        "help me raise",
        "raising money",
        "support us",
        "support me",
        "chip in",
        "please help",
        "send help",
        "any amount helps",
    ]

    # Optional: phrase-level patterns (captures payment handles / links)
    payment_patterns: List[re.Pattern] = [
        re.compile(r"\b\$[a-zA-Z0-9_]+\b"),  # $cashtag
        re.compile(r"(venmo\.com|paypal\.me)\/\S+"),  # venmo/paypal links
        re.compile(r"https?:\/\/\S*(gofundme|donate)\S*"),
    ]

    def predict(self, text: str) -> Dict:
        """
        Rule-based donation intent detector.
        """
        lowered = text.lower()

        # keyword hits
        kw_hit = any(kw in lowered for kw in self.donation_keywords)

        # pattern hits
        pattern_hit = any(p.search(lowered) for p in self.payment_patterns)

        score = 0.0
        if kw_hit:
            score += 0.6
        if pattern_hit:
            score += 0.4

        # clamp
        score = min(score, 1.0)

        return {
            "is_donation_related": score > 0.5,
            "confidence": round(score, 2),
            "signals": {
                "keyword_match": kw_hit,
                "pattern_match": pattern_hit,
            },
        }


# ============================================================
# MODULE 2 — Endpoint Extractor (URL + QR + Payment Handles)
# ============================================================
class EndpointExtractor:
    """
    Extract URLs, QR-embedded URLs, CashApp / Venmo handles.
    """

    url_pattern = re.compile(r"(https?://[^\s]+)")
    cash_pattern = re.compile(r"\$[A-Za-z0-9_]+")
    venmo_pattern = re.compile(r"@?[A-Za-z0-9_]+")

    def extract_urls(self, text: str) -> List[str]:
        return self.url_pattern.findall(text)

    def extract_qr_urls(self, post: Any) -> List[str]:
        """
        Decode QR codes from embedded images and return any URLs they contain.

        Assumes `post` is a FeedViewPost-like object:
            post.embed.images -> list of image views
            each image has `fullsize` or `thumb` URL attributes.
        """
        results: List[str] = []

        embed = getattr(post, "embed", None)
        if not embed:
            return results

        images = getattr(embed, "images", None)
        if not images:
            return results

        for img in images:
            img_url = getattr(img, "fullsize", None) or getattr(img, "thumb", None)
            if not img_url:
                continue

            try:
                resp = requests.get(img_url, timeout=5)
                resp.raise_for_status()
                pil_img = Image.open(BytesIO(resp.content))
            except Exception:
                continue

            try:
                decoded = qr_decode(pil_img)
            except Exception:
                continue

            for qr in decoded:
                try:
                    data = qr.data.decode("utf-8", errors="ignore").strip()
                except Exception:
                    continue

                if self.extract_urls(data):
                    results.append(data)

        # dedupe while preserving order
        seen = set()
        deduped = []
        for u in results:
            if u not in seen:
                seen.add(u)
                deduped.append(u)
        return deduped

    def extract_payment_handles(self, text: str) -> List[str]:
        handles = []

        for m in self.cash_pattern.findall(text):
            if m.startswith("$"):
                handles.append({"type": "cashapp", "handle": m})

        # TODO: refine Venmo detection
        return handles

    def run(self, text: str, post) -> List[Dict]:
        urls = self.extract_urls(text)
        qr_urls = self.extract_qr_urls(post)
        handles = self.extract_payment_handles(text)

        endpoints = []
        for u in urls:
            endpoints.append({"type": "url", "source": "text", "url": u})
        for u in qr_urls:
            endpoints.append({"type": "url", "source": "qr", "url": u})
        for h in handles:
            endpoints.append(h)

        return endpoints



# ============================================================
# MODULE 2 — Endpoint Extractor (URL + QR + Payment Handles)
# ============================================================
class EndpointExtractor:
    """
    Extract URLs, QR-embedded URLs, CashApp / Venmo handles.
    """

    url_pattern = re.compile(r"(https?://[^\s]+)")
    cash_pattern = re.compile(r"\$[A-Za-z0-9_]+")
    venmo_pattern = re.compile(r"@?[A-Za-z0-9_]+")

    def extract_urls(self, text: str) -> List[str]:
        return self.url_pattern.findall(text)

    def extract_qr_urls(self, post) -> List[str]:
        """
        Placeholder — implement QR decoding on post.embedded media.
        """
        return []  # TODO

    def extract_payment_handles(self, text: str) -> List[str]:
        handles = []

        for m in self.cash_pattern.findall(text):
            if m.startswith("$"):
                handles.append({"type": "cashapp", "handle": m})

        # TODO: refine Venmo detection
        return handles

    def run(self, text: str, post) -> List[Dict]:
        urls = self.extract_urls(text)
        qr_urls = self.extract_qr_urls(post)
        handles = self.extract_payment_handles(text)

        endpoints = []
        for u in urls:
            endpoints.append({"type": "url", "source": "text", "url": u})
        for u in qr_urls:
            endpoints.append({"type": "url", "source": "qr", "url": u})
        for h in handles:
            endpoints.append(h)

        return endpoints



"""
policy_proposal_labeler.py

Donation-Related Post Labeler for Bluesky
----------------------------------------
This labeler:
1) Detects potentially donation-related content
2) Extracts endpoints (URLs, QR-embedded URLs, payment handles)
3) Performs multi-layer verification:
   - Account-level verification via Bluesky API
   - Post-level verification (claims)
   - Endpoint-level verification (domain, DB, APIs)
4) Assigns “potentially donation-related” labels to posts

"""

import argparse
import os
import re
from typing import List, Dict, Optional

import requests
from dotenv import load_dotenv
from atproto import Client, models
from atproto_client.models.com.atproto.admin.defs import RepoRef
from atproto_client.models.com.atproto.repo.strong_ref import Main

